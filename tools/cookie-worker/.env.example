# Cookie Worker local config
# Copy to tools/cookie-worker/.env and fill in the values.

# VPS or local main API base.
API_BASE=http://127.0.0.1:8787

# Must match COOKIE_SYNC_TOKEN in the main service.
COOKIE_SYNC_TOKEN=

# Accounts to sync, comma separated.
GEMINI_ACCOUNTS=acc1,acc2,acc3

# Single-account override when you only want one account.
# COOKIE_WORKER_ACCOUNT=acc1

# Browser mode. npm run login always opens system Chrome for manual login,
# ignoring COOKIE_WORKER_OPEN_ONLY=false. sync/once use Playwright profiles.
COOKIE_WORKER_HEADLESS=true
COOKIE_WORKER_OPEN_ONLY=false
COOKIE_WORKER_ONCE=true
COOKIE_WORKER_MIN_INTERVAL_MINUTES=90
COOKIE_WORKER_MAX_INTERVAL_MINUTES=180
COOKIE_WORKER_POST_RETRIES=3
COOKIE_WORKER_POST_RETRY_DELAY_MS=2000
COOKIE_WORKER_BROWSER_CHANNEL=chrome

# Optional CDP mode: attach to an already-running Chrome instead of launching a
# dedicated Playwright profile, and sync that browser's current Gemini login.
# 可选 CDP 模式：附加到已运行的 Chrome，直接读取当前登录态，不再启动独立 profile。
#
# Option 1 - reuse your normal Chrome profile, no second login (Chrome 144+):
#   open chrome://inspect/#remote-debugging once and enable remote debugging,
#   then set COOKIE_WORKER_CDP_URL=auto. The Worker reads DevToolsActivePort
#   from the default User Data dir and connects to that running browser.
#
# Option 2 - attach to a Chrome started with a debug port. Chrome 136+ blocks
# --remote-debugging-port on the default profile, so use a separate data dir:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir=%TEMP%\gemini-cdp
#   COOKIE_WORKER_CDP_URL=http://127.0.0.1:9222
#
# COOKIE_WORKER_ACCOUNT is authoritative in this mode; it does not need to be
# listed in GEMINI_ACCOUNTS. COOKIE_WORKER_CREATE_ACCOUNT=true creates the
# account when it does not exist in the main service yet.
# COOKIE_WORKER_CDP_PROFILE_DIR overrides the User Data dir used by "auto".
# COOKIE_WORKER_CDP_URL=
# COOKIE_WORKER_CDP_PROFILE_DIR=
# COOKIE_WORKER_CREATE_ACCOUNT=false

# Per-account profile directories and proxies.
GEMINI_ACCOUNT_ACC1_PROFILE_DIR=profiles/acc1
GEMINI_ACCOUNT_ACC1_PROXY=http://127.0.0.1:10808
GEMINI_ACCOUNT_ACC2_PROFILE_DIR=profiles/acc2
GEMINI_ACCOUNT_ACC2_PROXY=http://127.0.0.1:8019/
GEMINI_ACCOUNT_ACC3_PROFILE_DIR=profiles/acc3
GEMINI_ACCOUNT_ACC3_PROXY=http://127.0.0.1:8017/
